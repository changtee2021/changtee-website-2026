# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local lead store / uploads
.data/
/public/uploads/leads/*
!/public/uploads/leads/.gitkeep

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# Keep optimized web PDFs in repo; ignore local full-res masters only
/public/_pdf-originals/

# supabase / temp
supabase/.temp/
.tmp-mig*.json
.tools/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
