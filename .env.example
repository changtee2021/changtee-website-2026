# Supabase — Chang Tee website project (wp-enterprise)
# Dashboard: https://supabase.com/dashboard/project/pfwygxzwlteqjnnwiwmb
NEXT_PUBLIC_SUPABASE_URL=https://pfwygxzwlteqjnnwiwmb.supabase.co
# Prefer legacy anon JWT for @supabase/supabase-js (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional modern publishable key (sb_publishable_...)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_SCHEMA=changtee_web
# Open Admin API without cookie — LOCAL ONLY. Forced off on Vercel/production.
ALLOW_OPEN_ADMIN_API=false
# HMAC signing secret for admin cookies (required on Vercel).
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# Local only: false opens /admin without login. Ignored on Vercel/production.
ADMIN_AUTH_ENFORCED=true
# Local tooling key for x-admin-dev-key (ignored on Vercel/production).
ADMIN_DEV_API_KEY=
# Bootstrap admin password (employee 000000). Required on Vercel/production.
DEMO_ADMIN_PASSWORD=
# Allow .data/leads.json only for local development. Do not enable on Vercel production.
ALLOW_LOCAL_LEAD_STORE=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Admin subdomain (production). Leave empty locally → use /admin
# NEXT_PUBLIC_ADMIN_URL=https://admin.changtee-curtain.com
NEXT_PUBLIC_PHONE_TEL=020000000
NEXT_PUBLIC_PHONE_DISPLAY=02-000-0000
# LINE OA ช่างตี๋ (@chang-tee)
NEXT_PUBLIC_LINE_URL=https://lin.ee/7Ul6K4n
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Gmail SMTP (changtee2021@gmail.com)
# Use Google App Password (not normal login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=changtee2021@gmail.com
SMTP_PASS=
EMAIL_FROM="ช่างตี๋ ผ้าม่าน <changtee2021@gmail.com>"
EMAIL_TO=changtee2021@gmail.com

# Spam protection (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# LINE Messaging API (optional sales notify)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_SALES_TO_ID=

# Marketing slots
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Optional enterprise webhook (Phase 2)
ENTERPRISE_WEBHOOK_URL=
ENTERPRISE_WEBHOOK_SECRET=
